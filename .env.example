# API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# Model ID (required)
MODEL_ID=claude-sonnet-4-6

# Base URL (optional, for Anthropic-compatible providers)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
#  Anthropic-compatible providers
#
#  Provider         MODEL_ID              SWE-bench  TB2     Base URL
#  ---------------  --------------------  ---------  ------  -------------------
#  Anthropic        claude-sonnet-4-6     79.6%      59.1%   (default)
#  MiniMax          MiniMax-M2.5          80.2%        -     see below
#  GLM (Zhipu)      glm-5                77.8%        -     see below
#  Kimi (Moonshot)  kimi-k2.5            76.8%        -     see below
#  DeepSeek         deepseek-chat        73.0%        -     see below
#                   (V3.2)
#
#  SWE-bench = SWE-bench Verified (Feb 2026)
#  TB2       = Terminal-Bench 2.0 (Feb 2026)
# =============================================================================

# =============================================================================
#  OpenAI API 兼容模式配置（用于 MiniMax、DeepSeek、GLM、Kimi 等）
# =============================================================================
# 设置为 "true" 启用 OpenAI 兼容 API 模式
USE_OPENAI_API=false

# OpenAI 兼容 API 的 API Key
OPENAI_API_KEY=sk-xxx

# OpenAI 兼容 API 的 Base URL
# MiniMax (国内): https://api.minimaxi.com/v1
# MiniMax (国际): https://api.minimax.io/v1
# DeepSeek: https://api.deepseek.com/v1
# Kimi: https://api.moonshot.ai/v1
# GLM: https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://api.minimaxi.com/v1

# 模型最大上下文窗口。支持纯数字、1M、1024K 等格式。
MAX_CONTEXT_TOKENS=1000000

# GLM (Zhipu)      https://z.ai
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.ai
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
# MODEL_ID=kimi-k2.5

# DeepSeek         https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-chat

# ---- China mainland ----

# MiniMax          https://platform.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# MODEL_ID=MiniMax-M2.5

# GLM (Zhipu)      https://open.bigmodel.cn
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.5

# DeepSeek (no regional split, same endpoint globally)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-chat

# =============================================================================
#  Context Compact 压缩参数（context_compact.py）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# L4 摘要压缩的字符数阈值
# CONTEXT_LIMIT_CHARS=50000

# 默认上下文窗口 token 数（按 DeepSeek-v4 1M 上下文设定；MAX_CONTEXT_TOKENS 未设置时回退到该值）
# DEFAULT_MAX_CONTEXT_TOKENS=1000000

# L1 snip 压缩：消息条数阈值 / 保留头尾
# SNIP_MAX_MESSAGES=50
# SNIP_KEEP_HEAD=3
# SNIP_KEEP_TAIL=47

# L2 micro_compact：保留最近 N 条 tool_result 不动
# KEEP_RECENT_TOOL_RESULTS=3

# L3 tool_result_budget：单条 tool_result 落盘阈值 / 单条 user 消息内 tool_result 字节上限 / 落盘后预览字符数
# PERSIST_THRESHOLD=30000
# MAX_TOOL_RESULT_BYTES=200000
# PREVIEW_LENGTH=2000

# L4 摘要触发比率（L1/L2/L3 无前置阈值，每轮必跑由各层内部判断；仅 L4 由该比例门控）
# SUMMARY_TRIGGER_RATIO=0.80

# L4 摘要时，保留最后 N 条消息原文不被摘要
# PRESERVE_RECENT_SUMMARY_MESSAGES=10

# reactive 兜底：保留最后 N 条原文 / 最大重试次数
# REACTIVE_KEEP_TAIL=5
# MAX_REACTIVE_RETRIES=1

# =============================================================================
#  Error Recovery 错误恢复参数（error_recovery.py）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# 截断时第一次升级到的 max_tokens 上限
# ESCALATED_MAX_TOKENS=64000

# 首轮请求的 max_tokens（升级前的额度）
# DEFAULT_MAX_TOKENS=8000

# max_tokens 截断后的最大续写次数
# MAX_RECOVERY_RETRIES=3

# 内层 with_retry 对 429/503 的最大重试次数
# MAX_RETRIES=10

# 指数退避的初始延迟（毫秒）；实际等待 = base * 2^attempt + 随机抖动
# BASE_DELAY_MS=500

# 退避上限（毫秒），防止指数爆炸
# BACKOFF_CAP_MS=32000

# 连续 503 错误次数上限；达到后切换到 FALLBACK_MODEL
# MAX_CONSECUTIVE_503=3

# 续写提示：模型输出被 max_tokens 截断后，追加到 messages 的 user 消息
# CONTINUATION_PROMPT=输出已达 token 上限，直接续写 —— 不要道歉，不要复述，从中途中断处接着往下写。

# =============================================================================
#  SubAgent 子智能体参数（subagent.py）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# 子智能体单轮 max_tokens 预算
# 思考模式开启 + reasoning_effort=high 时 4000 经常被思考耗光，导致 content 为空 → (no summary)
# 8000 与 Error Recovery 的 DEFAULT_MAX_TOKENS 对齐
# SUBAGENT_MAX_TOKENS=8000
